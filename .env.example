# Application Settings
APP_NAME="Autonomous AI Company - Agent Runtime"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Groq Model Provider Settings
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TIMEOUT_SECONDS=60

# Database Settings
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/agent_runtime"
DATABASE_ECHO=false

# Redis Settings (Optional for caching/state)
REDIS_URL="redis://localhost:6379/0"

# Execution Settings
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
DEFAULT_RUN_TIMEOUT_SECONDS=300
