# Application Settings
APP_NAME="Autonomous AI Company - Agent Runtime"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Groq Model Provider Settings
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_SECONDS=60

# Database Settings
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/agent_runtime"
DATABASE_ECHO=false

# Redis Settings (Optional for caching/state)
REDIS_URL="redis://localhost:6379/0"

# Execution Settings
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
DEFAULT_RUN_TIMEOUT_SECONDS=300

# OpenAI-compatible Model Provider (OpenAI, OpenRouter, Ollama, ...) - optional
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Authentication
# AUTH_REQUIRED=false disables authentication (local development only).
AUTH_REQUIRED=true
# Signing key for access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=""
AUTH_TOKEN_TTL_MINUTES=480
# Sent as the X-API-Key header; acts as platform administrator. Use it to create the first tenant and user.
ADMIN_API_KEY=""

# Software Studio (autonomous dev team)
# Engine: "loop" uses a model provider with an API key; "agy" uses the Antigravity CLI
# on your subscription login (no API key).
STUDIO_ENGINE="loop"
AGY_COMMAND="agy"
AGY_MODEL_MANAGER="gemini-3.1-pro-high"
AGY_MODEL_DEVELOPER="gemini-3.8-flash-high"
AGY_MODEL_REVIEWER="gemini-3.1-pro-low"
# Used once when a model reports it is out of quota
AGY_FALLBACK_MODEL="gemini-3.7-flash-medium"
AGY_TIMEOUT_MINUTES=20
# Developers working at the same time, each in its own git worktree
STUDIO_DEVELOPERS=2
# When every model is out of quota the project waits this long, then resumes by itself
STUDIO_QUOTA_RETRY_MINUTES=30
# Restart projects that were running when the API process stopped
STUDIO_AUTO_RESUME=true
STUDIO_PROVIDER="groq"
# Empty uses the provider's default model
STUDIO_MODEL=""
STUDIO_WORKSPACES_DIR="scratch/studio"
STUDIO_MAX_AGENT_STEPS=30
STUDIO_MAX_REWORK_ROUNDS=2
STUDIO_COMMAND_TIMEOUT_SECONDS=300
